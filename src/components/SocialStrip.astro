---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface SocialPost {
	image: ImageMetadata;
	alt: string;
	title?: string;
	tagline?: string;
	caption?: string;
}

interface Props {
	eyebrow?: string;
	heading?: string;
	intro?: string;
	posts: SocialPost[];
}

const { eyebrow, heading, intro, posts } = Astro.props;
---

{
	posts && posts.length > 0 && (
		<section class="social-strip border-t border-white/5 px-6 py-24 sm:py-32">
			<div class="mx-auto max-w-4xl">
				<div class="mx-auto max-w-2xl text-center sm:text-left">
					<p class="reveal text-eyebrow uppercase text-neutral-400">
						{eyebrow ?? 'Spec Campaign — Social'}
					</p>
					<h2 class="reveal mt-6 text-h2 text-neutral-100">
						{heading ?? 'Four signals in the stream.'}
					</h2>
					{intro && (
						<p class="reveal mt-6 text-body text-neutral-400">
							{intro}
						</p>
					)}
				</div>

				<div class="mt-20 flex flex-col items-center gap-20 sm:gap-28">
					{posts.map((post) => (
						<article class="reveal group w-full max-w-2xl">
							<div class="glow-frame rounded-2xl transition-transform duration-500 ease-out group-hover:-translate-y-1">
								<div class="glow-frame__inner overflow-hidden rounded-2xl border border-white/10 bg-black transition-colors duration-300 group-hover:border-purple-500/40">
									<Image
										src={post.image}
										alt={post.alt}
										format="avif"
										loading="lazy"
										class="w-full h-auto block object-contain"
									/>
								</div>
							</div>

							<div class="mt-6 px-1">
								{post.tagline && (
									<p class="text-eyebrow uppercase text-purple-400 tracking-wider">
										{post.tagline}
									</p>
								)}
								{post.title && (
									<h3 class="mt-2 text-h3 font-medium text-neutral-100 group-hover:text-purple-300 transition-colors">
										{post.title}
									</h3>
								)}
								{post.caption && (
									<p class="mt-3 text-body text-neutral-400 leading-relaxed">
										{post.caption}
									</p>
								)}
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	)
}
