---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A card face that dissolves from one image into another, on a slow loop.
 *
 * Built for Sketch to Video, where the project's whole claim is a before and an
 * after: the graphite drawing sits there, then the frame the film made from it
 * comes up over the top, then it goes back. The card states the method without
 * a word of copy on it.
 *
 * Deliberately not a video. `coverVideo` already exists for real footage and is
 * the better tool when there's a file to play — this is for the case where both
 * ends of the transformation are stills, which costs two images instead of a
 * clip and needs nothing exported.
 *
 * Same two rules as every other moving thing here: nothing animates off-screen,
 * and a visitor who asked for no motion keeps the first image, still.
 */
interface Props {
	/** The image the card rests on. */
	from: ImageMetadata;
	/** The image that comes up over it. */
	to: ImageMetadata;
	alt: string;
	class?: string;
}
const { from, to, alt, class: className = '' } = Astro.props;
const SIZES = '(max-width: 640px) 100vw, 512px';
---

<div class:list={['cover-fade', className]}>
	<Image src={from} alt={alt} widths={[480, 800, 1200]} sizes={SIZES} class="cover-fade__layer" />
	{/* The second image is decorative: it's the same scene, already described. */}
	<Image
		src={to}
		alt=""
		aria-hidden="true"
		widths={[480, 800, 1200]}
		sizes={SIZES}
		class="cover-fade__layer cover-fade__to"
	/>
</div>

<style>
	.cover-fade {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}
	/* `:global` because these <img>s are rendered by the Image component, and
	   Astro's scoping attribute doesn't reach inside a child component. They
	   stay contained by the scoped .cover-fade wrapper, so nothing leaks. */
	.cover-fade :global(.cover-fade__layer) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Long holds at both ends, a slow cross-over between them. The point is the
	   two states, not the transition — so most of the cycle is spent stopped. */
	@keyframes cover-fade {
		0%,
		28% {
			opacity: 0;
		}
		46%,
		78% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
	.cover-fade :global(.cover-fade__to) {
		opacity: 0;
		animation: cover-fade 9s ease-in-out infinite;
		/* Paused until the card is actually on screen — a grid of these should
		   cost nothing while it's above or below the fold. */
		animation-play-state: paused;
	}
	.cover-fade.is-visible :global(.cover-fade__to) {
		animation-play-state: running;
	}

	@media (prefers-reduced-motion: reduce) {
		.cover-fade :global(.cover-fade__to) {
			animation: none;
			opacity: 0;
		}
	}
</style>

<script>
	function initCoverFades() {
		const cards = document.querySelectorAll<HTMLElement>('.cover-fade:not([data-fade-init])');
		if (!cards.length) return;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
			cards.forEach((c) => (c.dataset.fadeInit = 'true'));
			return;
		}
		if (!('IntersectionObserver' in window)) {
			cards.forEach((c) => {
				c.dataset.fadeInit = 'true';
				c.classList.add('is-visible');
			});
			return;
		}
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) e.target.classList.toggle('is-visible', e.isIntersecting);
			},
			{ threshold: 0.15 }
		);
		cards.forEach((c) => {
			c.dataset.fadeInit = 'true';
			io.observe(c);
		});
	}
	document.addEventListener('astro:page-load', initCoverFades);
	initCoverFades();
</script>
