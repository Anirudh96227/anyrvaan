---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import WorkCover from '../components/WorkCover.tsx';
import LoopVideo from '../components/LoopVideo.astro';
import CoverFade from '../components/CoverFade.astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
	(a, b) =>
		(a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
		Number(b.data.year) - Number(a.data.year)
);

// Two tiers. Everything with a face sits in one two-across grid, in authored
// order — see each entry's `order`; the devotional films sit below the rest on
// purpose, because leading with the loudest images makes the studio look like
// one thing it isn't. Cover-less entries (the reference atlases, this site)
// close the page as a compact reading list.
//
// "Has a face" means a still, a looping clip, OR a coded cover — a project
// whose card draws or plays itself still belongs in the picture tier, not the
// text list.
const hasFace = (p: (typeof projects)[number]) =>
	Boolean(p.data.cover || p.data.coverVideo || p.data.coverMotion);
const grid = projects.filter(hasFace);
const references = projects.filter((p) => !hasFace(p));
---

<Layout
	title="Work — Anyrvaan"
	description="Case studies from the studio — films, interfaces, and the reference work behind them, each shown in full."
>
	<div class="page-shell min-h-screen bg-neutral-950 text-neutral-50">
		<Nav />
		<main>
			<PageHeader
				eyebrow="Selected Work"
				title="Work"
				intro="A small set of case studies, each shown in full — the context, the thinking, the drafts I threw away, and where it landed."
			/>

			<!-- Tier 1: every project with a face, two across, in authored order. -->
			<section class="mx-auto max-w-5xl px-6">
				<div class="grid gap-x-10 gap-y-16 sm:grid-cols-2">
					{
						grid.map((p) => (
							<a href={`/work/${p.id}/`} class="reveal group block">
								<div class="overflow-hidden rounded-2xl border border-white/10 bg-black">
									{p.data.coverVideo ? (
										<LoopVideo
											src={p.data.coverVideo}
											label={p.data.coverAlt ?? p.data.title}
											class="transition-transform duration-700 ease-out group-hover:scale-[1.03]"
										/>
									) : p.data.coverMotion ? (
										<WorkCover
											client:visible
											motif={p.data.coverMotion}
											className="transition-transform duration-700 ease-out group-hover:scale-[1.03]"
										/>
									) : p.data.coverFadeTo ? (
										<CoverFade
											from={p.data.cover!}
											to={p.data.coverFadeTo}
											alt={p.data.coverAlt ?? p.data.title}
											class="transition-transform duration-700 ease-out group-hover:scale-[1.03]"
										/>
									) : (
										<Image
											src={p.data.cover!}
											alt={p.data.coverAlt ?? p.data.title}
											widths={[480, 800, 1200]}
											sizes="(max-width: 640px) 100vw, 512px"
											class="aspect-video w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
										/>
									)}
								</div>
								<div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
									<h3 class="text-h3 text-neutral-50">{p.data.title}</h3>
									<p class="text-small text-neutral-400">{p.data.year}</p>
								</div>
								<p class="mt-2 text-small leading-relaxed text-neutral-400">
									{p.data.tags.join(' · ')}
								</p>
							</a>
						))
					}
				</div>
			</section>

			<!-- Tier 3: reference works — dense reading-list rows, no images. -->
			{
				references.length > 0 && (
					<section class="mx-auto max-w-5xl px-6 pb-32 pt-24">
						<p class="reveal text-eyebrow uppercase text-neutral-400">Field Guides &amp; References</p>
						<ul class="mt-8 flex flex-col divide-y divide-white/5 border-y border-white/5">
							{references.map((p) => (
								<li class="reveal">
									<a
										href={`/work/${p.id}/`}
										class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between"
									>
										<span class="text-body-lg text-neutral-200 transition-colors group-hover:text-neutral-50">
											{p.data.title}
										</span>
										<span class="text-small text-neutral-400">
											{p.data.tags[0]} — {p.data.year}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</div>
</Layout>
