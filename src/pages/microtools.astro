---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';

// Held page. The calculators, the browser extensions and the in-browser visual
// AI tools have all been taken off the site for now; their pages are parked
// under `src/_parked/microtools/` rather than deleted, so putting the section
// back is a move, not a rebuild.
//
// What's left is deliberately close to empty. A section that says "coming
// soon" and then lists nine things underneath it isn't holding space, it's
// still selling — so this one holds the space and nothing else.
---

<Layout
	title="Microtools — Anyrvaan"
	description="Small, single-purpose tools, built and shipped one at a time. This section is being rebuilt."
>
	<div class="page-shell min-h-screen bg-neutral-950 text-neutral-50">
		<Nav />
		<main>
			<PageHeader
				eyebrow="Build"
				title="Microtools"
				intro="Small tools, one purpose each, built the same way as everything else here — designed and coded by the same pair of hands."
			/>

			<section class="border-t border-white/5 px-6">
				<div class="mx-auto flex min-h-[46vh] max-w-4xl items-center py-24 sm:py-32">
					<div>
						<p class="reveal text-eyebrow uppercase text-neutral-500">Coming soon</p>
						<p class="reveal mt-8 max-w-xl text-body-lg text-neutral-400">
							This section is being rebuilt. It'll fill in as each tool ships, not before.
						</p>
					</div>
				</div>
			</section>

			<section class="border-t border-white/5 px-6 py-24 sm:py-32">
				<div class="mx-auto max-w-4xl">
					<p class="reveal max-w-2xl text-body text-neutral-500">
						If there's a small, specific tool you wish existed, that's a good reason to write
						in.
					</p>
					<a
						href="/contact"
						class="reveal mt-6 inline-block text-body text-neutral-300 transition-colors hover:text-neutral-50"
					>
						Suggest one &nearr;
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</div>
</Layout>
