---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import reelPoster from '../assets/work/reel-poster.jpg';

const email = 'anyrvaan@gmail.com';

const elsewhere = ['Instagram', 'LinkedIn', 'GitHub'];

// The practice, in evidence instead of adjectives — every number is a thing
// on this site you can go watch or push on. (The "one person" figure has
// nowhere to link now that this page *is* the studio page, so it doesn't.)
const numbers = [
	{ value: '41', label: 'short films, all rendered from code', href: '/work' },
	{
		value: '110',
		label: 'motion effects, catalogued and cross-indexed',
		href: '/work/motion-made-with-code/#effects-index',
	},
	{ value: '24', label: 'live interaction prototypes in the lab', href: '/experiments' },
	{ value: '1', label: 'person — I do the design and the code', href: null },
];

// Concrete offerings, derived from the case studies rather than aspiration.
const services = [
	{
		title: 'Web & Product Design',
		body: 'Websites and interfaces where the front-end engineering is part of the design — systems, performance, and the small interactions that make a screen feel inhabited. This site is the working sample.',
		tags: ['Web Design', 'Design Systems', 'Front-end Engineering'],
	},
	{
		title: 'Motion & Data Design',
		body: 'Dense or dry information turned legible at a glance — dashboards directed like film scenes, counters with real physics, charts that argue. Built in Remotion and code, not keyframed by hand.',
		tags: ['Motion Design', 'Data Visualization', 'Remotion'],
	},
	{
		title: 'Film & Creative Direction',
		body: 'Short-form film built around one real idea instead of a checklist of trends — devotional pieces, miniature worlds, a dashboard that holds you for a minute without a single word.',
		tags: ['Film', 'Creative Direction', 'Sound'],
	},
];

// Not a mission statement — the actual rules I catch myself working by.
const workNotes = [
	'I place things by hand, one at a time. Let a tool auto-arrange a layout and it comes out even — and even reads as nobody. The small irregularities are how you can tell a person was here.',
	'I keep the drafts I threw away, and I’ll show them to you. When I don’t know why something works, I say so instead of reaching for a reason that sounds right.',
	'Subtraction first. There’s an old idea I keep using — neti-neti, “not this, not this” — where you find the thing by removing everything it isn’t. That’s genuinely how I get to a frame.',
];
---

<Layout
	title="Studio & Contact — Anyrvaan"
	description="One person, Delhi-based, making quiet motion work and the interfaces around it. Write in — one person reads this inbox, and one person writes back."
>
	<div class="min-h-screen bg-neutral-950 text-neutral-50">
		<Nav />
		<main>
			<PageHeader
				eyebrow="Studio & Contact"
				title="Contact"
				intro="I'm Anirudh. I design and build things that move, and Anyrvaan is the name they ship under — no team behind the word, just me doing both the design and the code. I spend about four hours a day on the Delhi Metro, packed in, in motion I didn't choose. Almost everything I make is about stillness. I've stopped thinking that's a coincidence."
			/>

			<!-- The address first. Someone who clicked "Contact" shouldn't have to
			     scroll past the whole studio to find an email. -->
			<section class="border-t border-white/5 px-6 py-24 sm:py-32">
				<div class="mx-auto max-w-4xl">
					<p class="reveal text-eyebrow uppercase text-neutral-400">Write In</p>
					<a
						href={`mailto:${email}`}
						data-email={email}
						class="email-link reveal group mt-8 block w-fit text-h1 text-neutral-50 transition-colors hover:text-neutral-300"
					>
						<span class="email-link__label">{email}</span>
						<span
							aria-hidden="true"
							class="ml-2 inline-block transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
							>&nearr;</span
						>
					</a>
					<p class="reveal mt-8 max-w-md text-body text-neutral-400">
						There's no team here to route you through. If you write in, I'm the one reading it,
						and I'm the one who writes back.
					</p>
					<p class="reveal mt-5 max-w-md text-body text-neutral-500">
						Currently taking on a small number of new projects starting Autumn 2026. Reach out
						earlier to get in the queue.
					</p>
				</div>
			</section>

			<!-- Portfolio reel: a click-to-play facade. The frame stays on-brand
			     (the wordmark over the field) until you press play — only then
			     does the YouTube player load, so its own thumbnail never shows. -->
			<section class="border-t border-white/5 px-6 py-24 sm:py-32">
				<div class="mx-auto max-w-4xl">
					<p class="reveal text-eyebrow uppercase text-neutral-400">The Reel</p>
					<div class="glow-frame reveal mt-10 rounded-2xl">
						<div class="glow-frame__inner relative aspect-video overflow-hidden border border-white/10 bg-black">
							<button
								type="button"
								class="reel-facade group absolute inset-0 block h-full w-full cursor-pointer text-left"
								data-reel="84ceFWedjds"
								aria-label="Play the studio reel — “Hi, I’m Anirudh”"
							>
								<Image
									src={reelPoster}
									alt="The studio reel — the Anyrvaan wordmark over a starfield"
									class="h-full w-full object-cover opacity-90 transition-opacity duration-500 group-hover:opacity-100"
								/>
								<span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></span>
								<span class="absolute bottom-0 left-0 flex w-full items-center justify-between gap-4 p-5 sm:p-7">
									<span class="flex items-center gap-4">
										<span class="flex h-14 w-14 items-center justify-center rounded-full border border-white/40 bg-black/40 backdrop-blur-sm transition-colors group-hover:border-white group-hover:bg-black/60">
											<svg width="16" height="18" viewBox="0 0 16 18" fill="none" aria-hidden="true">
												<path d="M1 1.5v15l14-7.5-14-7.5z" fill="#fafafa"></path>
											</svg>
										</span>
										<span class="text-body text-neutral-50">Watch the reel — “Hi, I’m Anirudh”</span>
									</span>
									<span class="hidden text-small text-neutral-300 sm:block">2 min</span>
								</span>
							</button>
						</div>
					</div>
				</div>
			</section>

			<!-- The practice, counted instead of described. Each number links to
			     the place on the site where you can verify it. -->
			<section class="border-t border-white/5 px-6 py-24 sm:py-32">
				<div class="mx-auto max-w-5xl">
					<p class="reveal text-eyebrow uppercase text-neutral-400">The Practice, Counted</p>
					<div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-4">
						{
							numbers.map((n) => {
								const Tag = n.href ? 'a' : 'div';
								return (
									<Tag href={n.href ?? undefined} class="reveal group block">
										<p class="text-h1 tabular-nums text-neutral-50 transition-colors group-hover:text-neutral-200">
											{n.value}
										</p>
										<p class="mt-3 max-w-[16ch] text-small leading-relaxed text-neutral-400 transition-colors group-hover:text-neutral-300">
											{n.label}
										</p>
									</Tag>
								);
							})
						}
					</div>
				</div>
			</section>

			<!-- Services: concrete offerings, not just philosophy -->
			<section class="border-t border-white/5 px-6 py-24 sm:py-32">
				<div class="mx-auto max-w-5xl">
					<p class="reveal text-eyebrow uppercase text-neutral-400">Services</p>
					<h2 class="reveal mt-8 max-w-3xl text-h2 text-neutral-100">What that looks like, hired.</h2>
					<div class="mt-14 flex flex-col divide-y divide-white/5 border-t border-white/5">
						{
							services.map((s) => (
								<div class="reveal flex flex-col gap-4 py-8 sm:flex-row sm:items-start sm:justify-between sm:gap-12">
									<div class="sm:w-64 sm:shrink-0">
										<h3 class="text-h3 text-neutral-50">{s.title}</h3>
									</div>
									<div class="sm:max-w-xl">
										<p class="text-body text-neutral-400">{s.body}</p>
										<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
											{s.tags.map((t) => (
												<li class="text-small text-neutral-400">{t}</li>
											))}
										</ul>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- How I work: concrete rules, not a mission block -->
			<section class="border-t border-white/5 px-6 py-24 sm:py-32">
				<div class="mx-auto max-w-4xl">
					<p class="reveal text-eyebrow uppercase text-neutral-400">How I work</p>
					<ul class="mt-10 flex flex-col gap-8">
						{
							workNotes.map((line) => (
								<li class="reveal max-w-2xl text-body-lg text-neutral-300">{line}</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="border-t border-white/5 px-6 py-24 sm:py-32">
				<div class="mx-auto max-w-4xl">
					<p class="reveal text-eyebrow uppercase text-neutral-400">Elsewhere</p>
					<ul class="reveal mt-8 flex flex-wrap gap-x-8 gap-y-3">
						{
							elsewhere.map((platform) => (
								<li class="social-soon text-body text-neutral-300">{platform}</li>
							))
						}
					</ul>
					<p class="reveal mt-5 text-small text-neutral-500">Profiles going up shortly — email is the fastest way to reach me.</p>
				</div>
			</section>
		</main>
		<Footer />
	</div>
</Layout>

<style>
	/* Rubber-band snap on the email when copied — the Rebound gesture, once. */
	@keyframes email-rebound {
		0% { transform: translateX(0); }
		30% { transform: translateX(10px); }
		55% { transform: translateX(-5px); }
		78% { transform: translateX(2px); }
		100% { transform: translateX(0); }
	}
	.email-link.is-copied .email-link__label {
		display: inline-block;
		animation: email-rebound 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	@media (prefers-reduced-motion: reduce) {
		.email-link.is-copied .email-link__label { animation: none; }
	}

	/* Social names give a small playful lift on hover, so the row feels alive
	   even before the profiles are live. */
	.social-soon { transition: transform 0.25s ease, color 0.25s ease; transform-origin: left center; }
	.social-soon:hover { color: var(--color-neutral-50, #fafafa); }
	@media (prefers-reduced-motion: no-preference) {
		.social-soon:hover { transform: translateY(-2px); }
	}
</style>

<script>
	// Click the email → copy to clipboard, snap the address (Rebound), and swap
	// the label to "copied" for a moment. Falls back to the mailto: link if the
	// clipboard API is unavailable.
	function initEmailCopy() {
		const link = document.querySelector<HTMLAnchorElement>('.email-link:not([data-copy-init])');
		if (!link) return;
		link.dataset.copyInit = 'true';
		const label = link.querySelector<HTMLElement>('.email-link__label');
		const email = link.dataset.email ?? '';
		if (!label) return;
		const original = label.textContent;
		link.addEventListener('click', (e) => {
			if (!navigator.clipboard) return; // let mailto: proceed
			e.preventDefault();
			navigator.clipboard
				.writeText(email)
				.then(() => {
					label.textContent = 'copied to clipboard';
					link.classList.remove('is-copied');
					void link.offsetWidth; // restart the animation
					link.classList.add('is-copied');
					window.setTimeout(() => {
						label.textContent = original;
						link.classList.remove('is-copied');
					}, 1600);
				})
				.catch(() => {
					window.location.href = `mailto:${email}`;
				});
		});
	}
	document.addEventListener('astro:page-load', initEmailCopy);
	initEmailCopy();

	// Click-to-play: swap the on-brand poster for the real YouTube player only
	// on demand, so the video's own (off-brand) thumbnail never loads.
	function initReel() {
		const btn = document.querySelector<HTMLButtonElement>('.reel-facade:not([data-reel-init])');
		if (!btn) return;
		btn.dataset.reelInit = 'true';
		btn.addEventListener('click', () => {
			const id = btn.dataset.reel;
			if (!id) return;
			const iframe = document.createElement('iframe');
			iframe.className = 'h-full w-full';
			iframe.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1&autoplay=1`;
			iframe.title = 'The studio reel';
			iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
			iframe.allowFullscreen = true;
			btn.replaceWith(iframe);
		});
	}
	document.addEventListener('astro:page-load', initReel);
	initReel();
</script>
