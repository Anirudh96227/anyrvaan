---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import ExtensionPreview from '../../components/ExtensionPreview.tsx';

// Extensions — browser extensions, listed separately from the single-page
// tools above. Each one is real and installable; the preview beside it runs
// the actual effect on a loop rather than showing a recording of it.
const extensions: {
	name: string;
	slug: 'colourway' | 'typeset' | 'by-hand' | 'cold-read';
	tagline: string;
	body: string;
	options: string;
	download: string;
	size: string;
	steps: string[];
}[] = [
	{
		name: 'Colourway',
		slug: 'colourway',
		tagline: 'The same page, issued in a different set of colours',
		body: "Not an invert — inverting is why most theme extensions turn photographs into negatives and careful greys into mud. Every colour is taken into OKLCH, where lightness, chroma and hue are separable, and mapped along the page's own lightness axis: where a colour sits between this page's background and its text is what matters, which is why a light page inverts correctly and a page that is already dark doesn't get flipped inside out. Neutrals take the scheme's hue; anything that already has colour keeps its own, so the site's internal relationships survive. Then every text pair is measured with APCA and repaired if it falls short — APCA rather than the old 2.1 ratio, which misjudges exactly the dark backgrounds this spends its time on.",
		options:
			'Ink · Paper · Indigo · Teal · Maximum, with a contrast target of Lc 60, 75 or 90. Photographs are left alone unless you ask otherwise.',
		download: '/downloads/extensions/anyrvaan-colourway.zip',
		size: '48 KB',
		steps: [
			'Unzip it somewhere you intend to keep — deleting the folder uninstalls it.',
			'Open chrome://extensions (or edge://extensions) and turn on Developer mode.',
			'Click “Load unpacked” and pick the unzipped folder.',
			'Right-click the icon → Options to pick a scheme, then click it on any site.',
		],
	},
	{
		name: 'Typeset',
		slug: 'typeset',
		tagline: 'Re-sets any page in a pairing you chose',
		body: "The page dims from the top down, the type changes underneath, and each line comes back with its leading and measure corrected. Before it touches anything it reads the site and tells you what it found — the face, the size, the ratio, the measure — and what it did about it. Hold the backtick key to see the site's own type again, which is the only honest way to judge whether you improved it. Every face is one already on your machine, so nothing is downloaded and no site learns which font you picked.",
		options:
			'Editorial · Technical · Quiet · Display · Typewriter, plus type scale, leading correction, and a measure cap. Icon fonts and code are never touched.',
		download: '/downloads/extensions/anyrvaan-typeset.zip',
		size: '44 KB',
		steps: [
			'Unzip it somewhere you intend to keep — deleting the folder uninstalls it.',
			'Open chrome://extensions (or edge://extensions) and turn on Developer mode.',
			'Click “Load unpacked” and pick the unzipped folder.',
			'Right-click the icon → Options to choose a pairing, then click it on any article.',
		],
	},
	{
		name: 'By Hand',
		slug: 'by-hand',
		tagline: 'The page gets drawn, box by box',
		body: "Not filtered — drawn. Pen strokes travel along every box in reading order, top-left to bottom-right, at drawing speed. Rectangles get a second pass, because nobody draws a rectangle right the first time, and headings get underlined twice. Brush an element once it has landed and it re-strokes with a new seed, so the wobble is never the same twice. The paper has grain, an off-white that isn't white, and sits a fraction of a degree off-square.",
		options:
			'Six media with their own physics — pencil, ballpoint, marker, ink brush, charcoal, blueprint — on white, cream, graph, dot grid, blueprint or kraft paper.',
		download: '/downloads/extensions/anyrvaan-by-hand.zip',
		size: '46 KB',
		steps: [
			'Unzip it somewhere you intend to keep — deleting the folder uninstalls it.',
			'Open chrome://extensions (or edge://extensions) and turn on Developer mode.',
			'Click “Load unpacked” and pick the unzipped folder.',
			'Right-click the icon → Options to pick a medium and paper, then draw any page.',
		],
	},
	{
		name: 'Cold Read',
		slug: 'cold-read',
		tagline: 'Quiz first, then read — and read the parts you got wrong',
		body: "The odd one out: it doesn't change the page, it covers it. A handful of questions get built from the article's own sentences, you answer them before you've read a word, and you say how sure you were about each. Then the cover lifts and every sentence a question came from is marked in place, coloured by how you did — so the article you're about to read already knows which parts matter to you. Being confidently wrong is the thing a normal quiz can't see, because a score puts you next to someone who guessed right; here it's the one marked brightest. There is no score, and there never will be. A cross isn't a failure, it's a bookmark.",
		options:
			'Four to eight questions, the confidence tap on or off, and whether the page is covered while you answer — off means you can scroll away and find the answers, which rather defeats it.',
		download: '/downloads/extensions/anyrvaan-cold-read.zip',
		size: '55 KB',
		steps: [
			'Unzip it somewhere you intend to keep — deleting the folder uninstalls it.',
			'Open chrome://extensions (or edge://extensions) and turn on Developer mode.',
			'Click “Load unpacked” and pick the unzipped folder.',
			'Click the icon on any article to be quizzed on it; click again, or press Esc, to put it away.',
		],
	},
];
---

<Layout
	title="Extensions — Anyrvaan Microtools"
	description="Four browser extensions, each one doing a single thing to whatever page you're already on. Installed by hand, so you can read every line first."
>
	<div class="page-shell min-h-screen bg-neutral-950 text-neutral-50">
		<Nav />
		<main>
			<PageHeader
				eyebrow="Microtools"
				title="Extensions"
				intro="Four of them, each doing a single thing to whatever page you're already on. Three change how it looks; the fourth covers it up and asks you what you already know. None are in a web store — you install them by hand, which means you can also read every line before you do. Chrome, Edge, Brave, or any other Chromium browser."
			/>

<section class="border-t border-white/5 px-6 py-24 sm:py-32">
				<div class="mx-auto max-w-4xl">
					<p class="reveal mt-8 max-w-2xl text-body-lg text-neutral-300">
						Four browser extensions, each one doing a single thing to whatever page you're
						already on. None of them are in a web store — you install them by hand, which
						means you can also read every line before you do.
					</p>
					<p class="reveal mt-5 max-w-2xl text-body text-neutral-500">
						Chrome, Edge, Brave, or any other Chromium browser. Nothing is collected or sent
						anywhere; none of them ask for network access.
					</p>

					<div class="mt-16 space-y-24">
						{
							extensions.map((e) => (
								<article class="reveal scroll-mt-28" id={e.slug}>
									{/* The preview runs the real effect on a loop — not a recording. */}
									<div class="overflow-hidden rounded-2xl border border-white/10 bg-black">
										<ExtensionPreview client:visible kind={e.slug} />
									</div>

									<div class="mt-8 sm:flex sm:items-start sm:justify-between sm:gap-10">
										<div class="max-w-xl">
											<h3 class="text-h3 text-neutral-50">{e.name}</h3>
											<p class="mt-2 text-body text-neutral-400">{e.tagline}</p>
										</div>
										<a
											href={e.download}
											download
											class="mt-6 inline-flex shrink-0 items-center gap-3 rounded-full border border-white/15 px-6 py-3 text-small text-neutral-100 transition-colors hover:border-white/40 hover:bg-white/5 sm:mt-1"
										>
											Download
											<span class="text-neutral-500">.zip · {e.size}</span>
										</a>
									</div>

									<p class="mt-6 max-w-2xl text-body text-neutral-300">{e.body}</p>

									<p class="mt-5 max-w-2xl text-body text-neutral-500">
										<span class="text-neutral-400">Options —</span> {e.options}
									</p>

									<div class="mt-8 rounded-2xl border border-white/5 p-7">
										<p class="text-eyebrow uppercase text-neutral-500">How to use it</p>
										<ol class="mt-5 space-y-3">
											{e.steps.map((s, i) => (
												<li class="flex gap-4 text-body text-neutral-400">
													<span class="shrink-0 tabular-nums text-neutral-600">
														{String(i + 1).padStart(2, '0')}
													</span>
													<span>{s}</span>
												</li>
											))}
										</ol>
									</div>
								</article>
							))
						}
					</div>

					<div class="reveal mt-24 rounded-2xl border border-amber-200/15 bg-amber-100/[0.03] p-8">
						<p class="text-eyebrow uppercase text-amber-200/70">What they have in common</p>
						<p class="mt-5 max-w-2xl text-body text-neutral-300">
							All four are wired to notice when you stop. Leave the cursor alone and motes
							drift in from the edges of the screen — pigment in Colourway, letterforms in
							Typeset, graphite in By Hand, questions in Cold Read — curl toward the pointer,
							and are taken by it. They arrive on their own schedule, never the same gap
							twice, so you can't learn to expect them.
						</p>
						<p class="mt-4 max-w-2xl text-body text-neutral-500">
							None of them ask for network access, so none of them can phone home — not even
							Cold Read, which builds its questions on your machine out of the page's own
							sentences rather than sending them anywhere. Settings live in your browser's
							own synced storage. Every one of them is something you hold up to a page for a
							moment: reload it and the real site is back.
						</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</div>
</Layout>
